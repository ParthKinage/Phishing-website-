{
  "manifest_version": 3,
  "name": "Phishing Website Detector (course demo)",
  "version": "1.0.0",
  "description": "Checks the current tab's URL with a locally running phishing-detection API (http://127.0.0.1:8000).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check this page for phishing",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"]
}
